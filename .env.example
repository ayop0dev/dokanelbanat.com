# Public WordPress content API
WP_API_URL=

# WooCommerce Admin REST API — server only
WOO_API_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# WooCommerce Store API fallback
WOO_STORE_API_URL=

# Commerce bridge — server only
WOO_BACKEND_URL=
DB_BRIDGE_SECRET=

# Public frontend URL used in emails and links
PUBLIC_SITE_URL=

# Optional analytics; leave empty to disable GTM
GTM_CONTAINER_ID=

# DLB Initiative — Google Sheets service account (server only)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# DLB Initiative — Titan SMTP (server only)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# DLB Initiative — optional rate-limit overrides
DLB_RATE_LIMIT_MAX=
DLB_RATE_LIMIT_WINDOW_SECONDS=
